# Japan Demographics Analysis - Jupyter Notebook

```python
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from scipy import stats

# Load the data
subdivs = pd.read_excel('/home/suwaraich/Data_Science_Research/Week3/japan-subdivisions.xlsx')
areas = pd.read_excel('/home/suwaraich/Data_Science_Research/Week3/japan-prefecture-areas.xlsx')

# Prefectures
pref = subdivs[subdivs['Status'] == 'Prefecture'].reset_index(drop=True)
pref_names = pref['Name'].tolist()

# Cities
cities_df = subdivs[subdivs['Status'] == 'City (-shi)'].reset_index(drop=True)

# Density data from areas file
dens_col = [c for c in areas.columns if 'density' in str(c).lower()][0]
dens = areas[areas['Prefecture'].isin(pref_names)].reset_index(drop=True)[['Prefecture', dens_col]].dropna()

# Set plot style
sns.set_style('whitegrid')
sns.set_palette('Set2')

```

## Question A: Percentage change in population for prefectures from 1995 to 2020

```python
# Calculate percentage change
pct_change = (pref['pop2020'] - pref['pop1995']) / pref['pop1995'] * 100
pref['pct_change_1995_2020'] = pct_change

# Display results
results = pref[['Name', 'pop1995', 'pop2020', 'pct_change_1995_2020']].sort_values('pct_change_1995_2020')
print(results.to_string(index=False))
print(f"\nOverall population change: {pct_change.mean():.2f}%")
print(f"Median change: {pct_change.median():.2f}%")

```

## Question B: Time series of percentage change relative to 1995

```python
years = [1995, 2000, 2005, 2010, 2015, 2020]
pop_cols = ['pop1995', 'pop2000', 'pop2005', 'pop2010', 'pop2015', 'pop2020']

# Calculate percentage change for each year relative to 1995
changes = {}
for yr, col in zip(years, pop_cols):
    change = (pref[col] - pref['pop1995']) / pref['pop1995'] * 100
    changes[yr] = change.mean()

# Plot
plt.figure(figsize=(10, 6))
plt.plot(years, [changes[yr] for yr in years], 'o-', linewidth=2, markersize=8)
plt.title('Average Percentage Population Change in Japanese Prefectures\nRelative to 1995 Population', fontsize=13)
plt.xlabel('Census Year', fontsize=12)
plt.ylabel('Percentage Change (%)', fontsize=12)
plt.grid(True, alpha=0.3)
plt.axhline(y=0, color='red', linestyle='--', alpha=0.5, label='No change')
plt.xticks(years)
plt.legend()
plt.tight_layout()
plt.savefig('/home/suwaraich/ds_work/time_series_prefectures.png', dpi=150)
plt.show()

```

## Question C: Scatter plot of 1995 population vs percentage change (1995-2020)

```python
# Scatter plot
plt.figure(figsize=(10, 6))
sns.scatterplot(x=pref['pop1995'], y=pref['pct_change_1995_2020'], s=80, alpha=0.7)
plt.title('1995 Prefecture Population vs Percentage Change (1995-2020)', fontsize=13)
plt.xlabel('Population in 1995', fontsize=12)
plt.ylabel('Percentage Change (%)', fontsize=12)
plt.axhline(y=0, color='red', linestyle='--', alpha=0.5, label='No change')
plt.grid(True, alpha=0.3)

# Pearson correlation
corr, p_val = stats.pearsonr(pref['pop1995'], pref['pct_change_1995_2020'])
print(f"Pearson correlation: {corr:.4f} p-value: {p_val:.4f}")
plt.text(0.05, 0.95, f'r = {corr:.4f}', transform=plt.gca().transAxes, fontsize=11,
         verticalalignment='top', bbox=dict(boxstyle='round', facecolor='wheat', alpha=0.5))
plt.tight_layout()
plt.savefig('/home/suwaraich/ds_work/scatter_prefectures.png', dpi=150)
plt.show()

```

## Question D: Cities - relation between city size and percentage change

```python
# Calculate percentage change for cities
cities_df['pop1995_c'] = cities_df['pop1995']
cities_df['pop2020_c'] = cities_df['pop2020']
cities_df['pct_change_c'] = (cities_df['pop2020_c'] - cities_df['pop1995_c']) / cities_df['pop1995_c'] * 100

# Sort by city size
cities_sorted = cities_df.sort_values('pop1995_c', ascending=False).reset_index(drop=True)
print("Top 15 cities by 1995 population:")
print(cities_sorted[['Name', 'pop1995_c', 'pop2020_c', 'pct_change_c']].head(15).to_string(index=False))
print()

# Scatter plot: city size vs percentage change
plt.figure(figsize=(12, 6))
sns.scatterplot(x=cities_sorted['pop1995_c'], y=cities_sorted['pct_change_c'], s=60, alpha=0.6)
plt.title('City Size (1995) vs Percentage Population Change (1995-2020)', fontsize=13)
plt.xlabel('City Population in 1995', fontsize=12)
plt.ylabel('Percentage Change (%)', fontsize=12)
plt.axhline(y=0, color='red', linestyle='--', alpha=0.5, label='No change')
plt.grid(True, alpha=0.3)

# Pearson correlation
corr_city, p_val_city = stats.pearsonr(cities_sorted['pop1995_c'], cities_sorted['pct_change_c'])
print(f"Pearson correlation: {corr_city:.4f} p-value: {p_val_city:.4f}")
plt.text(0.05, 0.95, f'r = {corr_city:.4f}', transform=plt.gca().transAxes, fontsize=11,
